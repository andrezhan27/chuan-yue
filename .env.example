# Optional canonical URL for non-Vercel production builds.
# Vercel uses VERCEL_PROJECT_PRODUCTION_URL automatically when system
# environment variables are enabled for the project.
SITE_URL=

# Supabase project settings > API. The restaurants table must allow SELECT for
# the anon role represented by the publishable key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
